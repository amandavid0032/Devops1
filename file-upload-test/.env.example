# App
PORT=3000

# Your existing MongoDB Docker container from docker-cmd.md
MONGO_URI=mongodb://admin:password@localhost:27018/?authSource=admin
MONGO_DB_NAME=file_upload_test

# local = save to ./uploads/<email>/; s3 = upload to AWS S3
STORAGE_DRIVER=local

# Add these only when you are ready to test S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_FOLDER=uploads
