# App
PORT=3000

# MongoDB — when running the app with "npm start" against the Compose MongoDB (port 27019)
MONGO_URI=mongodb://admin:change-this-password@localhost:27019/?authSource=admin
MONGO_DB_NAME=user_portal

# Login sessions
SESSION_DAYS=7
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# local = save to ./uploads/<userId>/; s3 = upload to AWS S3
STORAGE_DRIVER=local

# Add these only when you are ready to test S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_FOLDER=uploads

# Used by compose.yaml for the MongoDB root password (set before the first start)
# MONGO_ROOT_PASSWORD=change-this-password
